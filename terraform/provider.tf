# Proveedor AWS. Las credenciales NO van en el código: se leen de
# ~/.aws/credentials (AWS Academy) o de las variables de entorno del pipeline.
terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project   = var.project_name
      ManagedBy = "terraform"
    }
  }
}
